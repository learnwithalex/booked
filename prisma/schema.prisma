// Booked — bookkeeping schema
//
// Double-entry ledger. Every posted transaction has debit and credit legs
// against accounts from a fixed chart. Bank/Stripe activity flows in as
// `SourceTransaction` rows, get categorised (deterministic rules first, then
// the LLM agent for the rest), and post to the ledger as `Entry` rows.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------- Identity --------

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  createdAt     DateTime @default(now())
  orgs          OrgUser[]
  loginTokens   LoginToken[]
}

model Org {
  id          String   @id @default(cuid())
  name        String
  createdAt   DateTime @default(now())
  users       OrgUser[]
  accounts    Account[]
  sources     SourceConnection[]
  sourceTxns  SourceTransaction[]
  entries     Entry[]
  rules       Rule[]
  periods     Period[]
  packets     ClosePacket[]
  anomalies   Anomaly[]
}

model OrgUser {
  id     String @id @default(cuid())
  orgId  String
  userId String
  role   String @default("owner") // owner | member (v1 = owner only)
  org    Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
}

model LoginToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// -------- Chart of accounts (double-entry) --------
//
// Fixed chart in v1. `type` drives statement placement and normal balance.

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model Account {
  id        String      @id @default(cuid())
  orgId     String
  code      String      // e.g. "1000", "4000"
  name      String      // e.g. "Bank — Operating", "Revenue — Subscriptions"
  type      AccountType
  parentId  String?
  createdAt DateTime    @default(now())
  org       Org         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent    Account?    @relation("AccountTree", fields: [parentId], references: [id])
  children  Account[]   @relation("AccountTree")
  lines     EntryLine[]

  @@unique([orgId, code])
  @@index([orgId, type])
}

// -------- Source data (raw feed rows) --------

enum SourceKind {
  PLAID
  STRIPE
}

enum SourceStatus {
  ACTIVE
  DISCONNECTED
  ERROR
}

model SourceConnection {
  id            String       @id @default(cuid())
  orgId         String
  kind          SourceKind
  externalId    String       // Plaid item_id or Stripe account id
  accessToken   String       // encrypted at rest — TODO in ingestion layer
  status        SourceStatus @default(ACTIVE)
  cursor        String?      // Plaid sync cursor / Stripe pagination anchor
  connectedAt   DateTime     @default(now())
  lastSyncedAt  DateTime?
  org           Org          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  transactions  SourceTransaction[]

  @@unique([orgId, kind, externalId])
}

enum SourceTxnStatus {
  PENDING      // fetched, not yet categorised
  CATEGORISED  // agent proposed a category, awaiting or auto-posted
  POSTED       // an Entry has been created against it
  IGNORED      // user marked as skip (transfer, duplicate, etc.)
}

model SourceTransaction {
  id             String          @id @default(cuid())
  orgId          String
  connectionId   String
  externalId     String          // Plaid transaction_id / Stripe id
  occurredAt     DateTime
  amountCents    BigInt          // signed; positive = money in
  currency       String          @default("USD")
  merchant       String?
  description    String?
  raw            Json            // full source payload, kept for reprocessing
  status         SourceTxnStatus @default(PENDING)
  confidence     Float?          // categorisation confidence 0..1
  categoryHint   String?         // account code the agent proposed
  entryId        String?         @unique
  ignoredReason  String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  org        Org              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  connection SourceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  entry      Entry?           @relation(fields: [entryId], references: [id])

  @@unique([connectionId, externalId])
  @@index([orgId, status])
  @@index([orgId, occurredAt])
}

// -------- Ledger (double-entry postings) --------

model Entry {
  id          String    @id @default(cuid())
  orgId       String
  occurredAt  DateTime
  memo        String?
  createdAt   DateTime  @default(now())
  createdBy   String    // "agent" | userId
  periodId    String?

  org     Org         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  period  Period?     @relation(fields: [periodId], references: [id])
  lines   EntryLine[]
  source  SourceTransaction?

  @@index([orgId, occurredAt])
  @@index([orgId, periodId])
}

// Every Entry has ≥2 lines. Sum of debits == sum of credits (enforced in code).
model EntryLine {
  id          String @id @default(cuid())
  entryId     String
  accountId   String
  debitCents  BigInt @default(0)
  creditCents BigInt @default(0)

  entry   Entry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id])

  @@index([entryId])
  @@index([accountId])
}

// -------- Rules (deterministic categorisation, applied before LLM) --------

enum RuleField {
  MERCHANT
  DESCRIPTION
}

enum RuleOp {
  EQUALS
  CONTAINS
  STARTS_WITH
  REGEX
}

model Rule {
  id          String    @id @default(cuid())
  orgId       String
  field       RuleField
  op          RuleOp
  pattern     String
  accountCode String    // target account for the categorisation
  priority    Int       @default(0)
  createdAt   DateTime  @default(now())
  createdBy   String    // "agent-learned" | userId
  org         Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, priority])
}

// -------- Periods + close packets --------

enum PeriodStatus {
  OPEN
  CLOSED
}

model Period {
  id        String       @id @default(cuid())
  orgId     String
  year      Int
  month     Int          // 1..12
  status    PeriodStatus @default(OPEN)
  closedAt  DateTime?
  closedBy  String?
  org       Org          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  entries   Entry[]
  packets   ClosePacket[]

  @@unique([orgId, year, month])
}

model ClosePacket {
  id          String   @id @default(cuid())
  orgId       String
  periodId    String
  createdAt   DateTime @default(now())
  pdfUrl      String?  // R2 / Orizon CDN URL once rendered
  summary     String?  // plain-English month summary written by the agent
  metricsJson Json     // { revenue, expenses, netIncome, cashDelta, ... }
  org         Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  period      Period   @relation(fields: [periodId], references: [id], onDelete: Cascade)
}

// -------- Anomalies (weekly digest) --------

enum AnomalyKind {
  UNUSUAL_AMOUNT
  DUPLICATE
  CATEGORY_DRIFT
  MISSING_RECONCILIATION
  BURN_SPIKE
}

model Anomaly {
  id           String      @id @default(cuid())
  orgId        String
  kind         AnomalyKind
  detectedAt   DateTime    @default(now())
  detailsJson  Json
  txnId        String?     // related SourceTransaction, if any
  resolved     Boolean     @default(false)
  resolvedAt   DateTime?
  org          Org         @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, resolved])
}
